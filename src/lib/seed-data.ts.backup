// Helper functions
export function getCategoryById(id: string) {
  return categories.find(c => c.id === id);
}

export function getSubcategoriesForCategory(categoryId: string) {
  return subcategories.filter(s => s.category_id === categoryId);
}

export function getFlashcardsForSubcategory(subcategoryId: string) {
  return flashcards.filter(f => f.subcategory_id === subcategoryId);
}

export function getFlashcardsForCategory(categoryId: string) {
  const subIds = subcategories
    .filter(s => s.category_id === categoryId)
    .map(s => s.id);
  return flashcards.filter(f => subIds.includes(f.subcategory_id));
}

export function getQuestionsForCategory(categoryId: string) {
  const subIds = subcategories
    .filter(s => s.category_id === categoryId)
    .map(s => s.id);
  return questions.filter(q => subIds.includes(q.subcategory_id));
}
